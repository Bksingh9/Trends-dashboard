    "db:push": "drizzle-kit push",
    "etl:run": "tsx scripts/etl.ts run",
    "discover": "tsx scripts/discover.ts",
    "etl:seed": "tsx scripts/etl.ts seed",
    "etl:backfill": "tsx scripts/etl.ts backfill",
    "etl:status": "tsx scripts/etl.ts status",
    "verify:browser": "tsx scripts/verify-browser.ts",
    "e2e": "playwright test",
    "e2e:a11y": "playwright test e2e/a11y.spec.ts",
